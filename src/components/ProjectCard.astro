---
/** Tier-1 project: wide card with an inline SVG schematic and three labelled blocks. */
import ScopeBadge from './ScopeBadge.astro';
import ProjectLinks from './ProjectLinks.astro';
import TudDiagram from './diagrams/TudDiagram.astro';
import ShopDiagram from './diagrams/ShopDiagram.astro';
import AjSchoolDiagram from './diagrams/AjSchoolDiagram.astro';
import type { Dict, Lang, Project } from '../i18n';

interface Props {
  project: Project;
  index: number;
  labels: Dict['projects']['labels'];
  lang: Lang;
}

const { project: p, index, labels, lang } = Astro.props;
const num = String(index + 1).padStart(2, '0');
const Diagram = { tud: TudDiagram, shop: ShopDiagram, ajschool: AjSchoolDiagram }[p.diagram ?? 'tud'];
// Alternate the diagram side on desktop for an editorial rhythm.
const flip = index % 2 === 1;
---

<article class="card reveal group/card overflow-hidden" aria-labelledby={`project-${p.id}`}>
  <!-- Header strip -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-6 py-3 sm:px-8">
    <div class="flex items-center gap-3 font-mono text-xs text-subtle">
      <span class="text-primary transition-colors duration-200 group-hover/card:text-accent">P-{num}</span>
      <span aria-hidden="true">/</span>
      <span>{p.period}</span>
      <span aria-hidden="true" class="hidden sm:inline">/</span>
      <span class="hidden sm:inline">{p.context}</span>
    </div>
    <ScopeBadge tone={p.scopeTone} label={p.scope} />
  </div>

  <div class="grid lg:grid-cols-12">
    <!-- Diagram -->
    {
      p.diagram && (
        <figure
          class:list={[
            'grid-paper relative border-b border-line bg-surface-2/40 p-5 sm:p-6 lg:col-span-5 lg:flex lg:flex-col lg:justify-center lg:border-b-0',
            flip ? 'lg:order-2 lg:border-l' : 'lg:border-r',
          ]}
        >
          <div class="mx-auto w-full max-w-md">
            <Diagram lang={lang} />
          </div>
          <figcaption class="mt-2 font-mono text-[10.5px] tracking-wide text-subtle uppercase">
            Fig. P-{num} · {labels.schema}
          </figcaption>
        </figure>
      )
    }

    <!-- Content -->
    <div class:list={['flex flex-col p-6 sm:p-8', p.diagram ? 'lg:col-span-7' : 'lg:col-span-12', flip && 'lg:order-1']}>
      {p.subtitle && <p class="eyebrow mb-2">{p.subtitle}</p>}
      <h3 id={`project-${p.id}`} class="text-xl font-semibold tracking-tight text-balance text-primary sm:text-2xl">{p.title}</h3>
      <p class="mt-1 font-mono text-xs text-subtle sm:hidden">{p.context}</p>

      <dl class="mt-6 divide-y divide-line border-y border-line">
        <div class="grid gap-1.5 py-4 sm:grid-cols-[10.5rem_1fr] sm:gap-4">
          <dt class="font-mono text-[11px] leading-6 tracking-wide text-subtle uppercase">{labels.role}</dt>
          <dd class="text-sm leading-6 text-pretty">{p.role}</dd>
        </div>
        <div class="grid gap-1.5 py-4 sm:grid-cols-[10.5rem_1fr] sm:gap-4">
          <dt class="font-mono text-[11px] leading-6 tracking-wide text-subtle uppercase">{labels.build}</dt>
          <dd>
            <ul class="space-y-2">
              {
                p.build.map((b) => (
                  <li class="relative pl-4 text-sm leading-6 text-pretty">
                    <span class="absolute top-[0.7rem] left-0 h-px w-2 bg-primary" aria-hidden="true" />
                    {b}
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
        <div class="grid gap-1.5 py-4 sm:grid-cols-[10.5rem_1fr] sm:gap-4">
          <dt class="font-mono text-[11px] leading-6 tracking-wide text-subtle uppercase">{labels.outcome}</dt>
          <dd class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm leading-6">
            {p.metric && <span class="font-mono text-2xl font-medium tracking-tight text-accent">{p.metric.value}</span>}
            <span class="text-pretty">{p.outcome}</span>
          </dd>
        </div>
      </dl>

      <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={labels.stack}>
        {p.stack.map((s) => <li class="rounded-md border border-line bg-surface-2 px-2 py-1 font-mono text-[11px] leading-4 text-muted">{s}</li>)}
      </ul>

      {
        (p.links.length > 0 || p.note) && (
          <div class="mt-6">
            <ProjectLinks links={p.links} note={p.note} />
          </div>
        )
      }
    </div>
  </div>
</article>
