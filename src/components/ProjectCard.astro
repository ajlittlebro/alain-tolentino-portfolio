---
import Icon from './Icon.astro';
import type { Project, ProjectLink } from '../i18n';

interface Props {
  project: Project;
  index: number;
  stackLabel: string;
  resultLabel: string;
}

const { project: p, index, stackLabel } = Astro.props;
const num = String(index + 1).padStart(2, '0');

const scopeClass = {
  client: 'border-accent/40 bg-accent-soft text-accent',
  study: 'border-line-strong text-muted',
  ongoing: 'border-dashed border-line-strong text-muted',
}[p.scopeTone];

const linkIcon = (l: ProjectLink) => ({ demo: 'play', site: 'globe', repo: 'github' } as const)[l.kind];
---

<article
  class="reveal group/card relative grid gap-6 rounded-2xl border border-line bg-surface p-6 transition-[border-color,box-shadow] duration-300 hover:border-line-strong hover:shadow-[0_12px_32px_-16px_rgb(0_0_0/0.18)] sm:p-8 md:grid-cols-12 md:gap-8"
  aria-labelledby={`project-${p.id}`}
>
  <!-- Meta column -->
  <div class="flex flex-col gap-4 md:col-span-4">
    <div class="flex items-baseline justify-between gap-4 md:flex-col md:items-start md:gap-3">
      <span class="font-mono text-4xl font-medium tracking-tight text-line-strong transition-colors duration-300 group-hover/card:text-accent sm:text-5xl" aria-hidden="true">{num}</span>
      <span class="font-mono text-xs text-subtle">{p.period}</span>
    </div>
    <div class="flex flex-col items-start gap-2 text-sm">
      <p class="text-muted">{p.context}</p>
      <p class:list={['inline-flex items-center gap-1.5 rounded-md border px-2 py-1 font-mono text-[11px] leading-4', scopeClass]}>
        {p.scopeTone === 'client' && <span class="size-1.5 rounded-full bg-accent" aria-hidden="true" />}
        {p.scope}
      </p>
    </div>

    {
      p.metric && (
        <div class="mt-auto hidden rounded-xl border border-line bg-surface-2 p-4 md:block">
          <p class="text-4xl font-semibold tracking-tight text-accent">{p.metric.value}</p>
          <p class="mt-1 text-xs leading-5 text-muted">{p.metric.label}</p>
        </div>
      )
    }
  </div>

  <!-- Content column -->
  <div class="flex flex-col md:col-span-8">
    {p.subtitle && <p class="eyebrow mb-2">{p.subtitle}</p>}
    <h3 id={`project-${p.id}`} class="text-xl font-semibold tracking-tight text-balance sm:text-2xl">
      {p.title}
    </h3>
    <p class="mt-3 leading-7 text-pretty text-muted">{p.summary}</p>

    {
      p.metric && (
        <div class="mt-5 flex items-baseline gap-3 rounded-xl border border-line bg-surface-2 p-4 md:hidden">
          <p class="text-3xl font-semibold tracking-tight text-accent">{p.metric.value}</p>
          <p class="text-xs leading-5 text-muted">{p.metric.label}</p>
        </div>
      )
    }

    {
      p.caseStudy && (
        <dl class="mt-6 divide-y divide-line border-y border-line">
          {p.caseStudy.map((c) => (
            <div class="grid gap-1 py-3 sm:grid-cols-[8.5rem_1fr] sm:gap-4">
              <dt class="font-mono text-xs leading-6 text-subtle">{c.label}</dt>
              <dd class="text-sm leading-6">{c.text}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      p.bullets && (
        <ul class="mt-5 space-y-2.5">
          {p.bullets.map((b) => (
            <li class="relative pl-5 text-sm leading-6">
              <span class="absolute top-[0.7rem] left-0 h-px w-2.5 bg-subtle" aria-hidden="true" />
              {b}
            </li>
          ))}
        </ul>
      )
    }

    {
      p.subprojects && (
        <ul class="mt-6 grid gap-3">
          {p.subprojects.map((s) => (
            <li class="rounded-xl border border-line p-4 sm:p-5">
              <h4 class="text-sm font-semibold tracking-tight">{s.title}</h4>
              <p class="mt-1.5 text-sm leading-6 text-muted">{s.text}</p>
              {s.links && (
                <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
                  {s.links.map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm font-medium text-accent"
                    >
                      <Icon name={linkIcon(l)} />
                      <span class="link-underline">{l.label}</span>
                      <Icon name="arrow-up-right" size={14} />
                    </a>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-6">
      <ul class="flex flex-wrap gap-1.5" aria-label={stackLabel}>
        {
          p.stack.map((s) => (
            <li class="rounded-md border border-line bg-surface-2 px-2 py-1 font-mono text-[11px] leading-4 text-muted">{s}</li>
          ))
        }
      </ul>
    </div>

    {
      (p.links.length > 0 || p.note) && (
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-5">
          {p.links.map((l) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-accent"
            >
              <Icon name={linkIcon(l)} />
              <span class="link-underline">{l.label}</span>
              <Icon name="arrow-up-right" size={14} />
            </a>
          ))}
          {p.note && (
            <p class="inline-flex items-center gap-1.5 text-sm text-muted">
              <Icon name="lock" size={14} />
              {p.note}
            </p>
          )}
        </div>
      )
    }
  </div>
</article>
