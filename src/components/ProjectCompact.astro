---
/** Tier-2 project: compact card with the same three labelled blocks. */
import ScopeBadge from './ScopeBadge.astro';
import ProjectLinks from './ProjectLinks.astro';
import type { Dict, Project } from '../i18n';

interface Props {
  project: Project;
  index: number;
  labels: Dict['projects']['labels'];
}
const { project: p, index, labels } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article
  class:list={['card reveal group/card flex flex-col p-6', p.wide && 'md:col-span-2 md:grid md:grid-cols-12 md:gap-8']}
  aria-labelledby={`project-${p.id}`}
>
  <div class:list={[p.wide && 'md:col-span-5']}>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <span class="font-mono text-xs text-subtle">
        <span class="text-primary transition-colors duration-200 group-hover/card:text-accent">P-{num}</span>
        <span aria-hidden="true"> / </span>{p.period}
      </span>
      <ScopeBadge tone={p.scopeTone} label={p.scope} />
    </div>
    {p.subtitle && <p class="eyebrow mt-5">{p.subtitle}</p>}
    <h3 id={`project-${p.id}`} class:list={['text-lg font-semibold tracking-tight text-balance text-primary', p.subtitle ? 'mt-1.5' : 'mt-5']}>
      {p.title}
    </h3>
    <p class="mt-1 font-mono text-xs text-subtle">{p.context}</p>
  </div>

  <div class:list={['flex flex-1 flex-col', p.wide && 'md:col-span-7']}>
    <dl class="mt-5 space-y-4 border-t border-line pt-4 text-sm leading-6">
      <div>
        <dt class="font-mono text-[11px] tracking-wide text-subtle uppercase">{labels.role}</dt>
        <dd class="mt-1 text-pretty">{p.role}</dd>
      </div>
      <div>
        <dt class="font-mono text-[11px] tracking-wide text-subtle uppercase">{labels.build}</dt>
        <dd class="mt-1">
          <ul class="space-y-1.5">
            {
              p.build.map((b) => (
                <li class="relative pl-4 text-pretty">
                  <span class="absolute top-[0.7rem] left-0 h-px w-2 bg-primary" aria-hidden="true" />
                  {b}
                </li>
              ))
            }
          </ul>
        </dd>
      </div>
      <div>
        <dt class="font-mono text-[11px] tracking-wide text-subtle uppercase">{labels.outcome}</dt>
        <dd class="mt-1 text-pretty">{p.outcome}</dd>
      </div>
    </dl>

    <ul class="mt-5 flex flex-wrap gap-1.5" aria-label={labels.stack}>
      {p.stack.map((s) => <li class="rounded-md border border-line bg-surface-2 px-2 py-1 font-mono text-[11px] leading-4 text-muted">{s}</li>)}
    </ul>

    {
      (p.links.length > 0 || p.note) && (
        <div class="mt-auto pt-5">
          <ProjectLinks links={p.links} note={p.note} />
        </div>
      )
    }
  </div>
</article>
