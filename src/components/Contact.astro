---
import Icon from './Icon.astro';
import { getDict, PROFILE, CV_ENABLED, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = getDict(lang);
const t = dict.contact;
const hero = dict.hero;
---

<section id="contact" class="py-20 md:py-28" aria-labelledby="contact-title">
  <div class="container-page">
    <div class="reveal grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <p class="eyebrow pt-1.5">{t.eyebrow}</p>
      </div>
      <div class="md:col-span-8">
        <h2 id="contact-title" class="text-3xl font-semibold tracking-tight text-balance sm:text-5xl">{t.title}</h2>
        <p class="mt-5 max-w-2xl text-base leading-7 text-pretty text-muted sm:text-lg sm:leading-8">{t.text}</p>

        <div class="mt-10 overflow-hidden rounded-2xl border border-line bg-surface">
          <div class="flex flex-col gap-4 border-b border-line p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
            <div class="min-w-0">
              <p class="eyebrow">{t.emailLabel}</p>
              <a
                href={`mailto:${PROFILE.email}`}
                class="link-underline mt-1.5 inline-block text-lg font-medium tracking-tight break-all sm:text-xl"
              >
                {PROFILE.email}
              </a>
            </div>
            <div class="flex shrink-0 gap-2">
              <button
                type="button"
                data-copy={PROFILE.email}
                data-label-copied={t.copied}
                class="inline-flex h-10 items-center gap-2 rounded-lg border border-line-strong px-4 text-sm font-medium transition-colors hover:border-fg"
              >
                <Icon name="copy" class="copy-icon" />
                <Icon name="check" class="check-icon hidden text-ok" />
                <span class="copy-label">{t.copy}</span>
              </button>
              <a
                href={`mailto:${PROFILE.email}`}
                class="inline-flex h-10 items-center gap-2 rounded-lg bg-fg px-4 text-sm font-medium text-bg transition-opacity hover:opacity-90"
              >
                <Icon name="mail" />
                {t.emailLabel}
              </a>
            </div>
          </div>

          <div class:list={['grid', CV_ENABLED && 'sm:grid-cols-2']}>
            <div class:list={['p-5 sm:p-6', CV_ENABLED && 'border-b border-line sm:border-r sm:border-b-0']}>
              <p class="eyebrow">{t.profilesLabel}</p>
              <ul class="mt-3 flex flex-col gap-2">
                <li>
                  <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 text-sm font-medium">
                    <Icon name="github" />
                    <span class="link-underline">github.com/ajlittlebro</span>
                    <Icon name="arrow-up-right" size={14} class="text-subtle transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </a>
                </li>
                <li>
                  <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 text-sm font-medium">
                    <Icon name="linkedin" />
                    <span class="link-underline">linkedin.com/in/alain-tolentinoi</span>
                    <Icon name="arrow-up-right" size={14} class="text-subtle transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </a>
                </li>
              </ul>
            </div>
            {
              CV_ENABLED && (
                <div class="p-5 sm:p-6">
                  <p class="eyebrow">{t.cvLabel}</p>
                  <a href={hero.cvHref} download={hero.cvFile} class="group mt-3 inline-flex items-center gap-2 text-sm font-medium">
                    <Icon name="download" class="transition-transform group-hover:translate-y-0.5" />
                    <span class="link-underline">{hero.ctaCv}</span>
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('.copy-label');
    const original = label?.textContent ?? '';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      } catch {
        // Clipboard unavailable (e.g. insecure context): fall back to mailto.
        window.location.href = `mailto:${btn.dataset.copy}`;
        return;
      }
      if (label) label.textContent = btn.dataset.labelCopied ?? original;
      btn.querySelector('.copy-icon')?.classList.add('hidden');
      btn.querySelector('.check-icon')?.classList.remove('hidden');
      setTimeout(() => {
        if (label) label.textContent = original;
        btn.querySelector('.copy-icon')?.classList.remove('hidden');
        btn.querySelector('.check-icon')?.classList.add('hidden');
      }, 2000);
    });
  });
</script>
