---
/** 05 // Lebenslauf & Kontakt – direct contact actions + CV download hub. */
import Icon from './Icon.astro';
import CopyEmail from './CopyEmail.astro';
import SectionHead from './SectionHead.astro';
import { getDict, PROFILE, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const t = d.contact;
---

<section id={d.sections.contact} class="py-20 md:py-28" aria-labelledby="contact-title">
  <div class="container-page">
    <SectionHead id="contact-title" eyebrow={t.eyebrow} title={t.title} intro={t.text} />

    <div class="mt-14 grid gap-6 lg:grid-cols-12 lg:items-start">
      <!-- Direct contact -->
      <div class="panel reveal p-6 sm:p-8 lg:col-span-7">
        <p class="eyebrow">{t.emailLabel}</p>
        <a href={`mailto:${PROFILE.email}`} class="link-underline mt-2 inline-block font-mono text-[15px] font-medium break-all text-brand min-[400px]:text-lg sm:text-2xl">
          {PROFILE.email}
        </a>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={`mailto:${PROFILE.email}`}
            class="inline-flex h-11 items-center gap-2 rounded-lg bg-brand px-5 text-sm font-semibold text-on-brand transition-opacity duration-200 hover:opacity-90"
          >
            <Icon name="mail" />
            {t.send}
          </a>
          <CopyEmail lang={lang} />
        </div>

        <p class="eyebrow mt-8">{t.profilesLabel}</p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          <li>
            <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-2.5 rounded-lg border border-hairline px-3.5 py-3 text-sm transition-colors duration-200 hover:border-accent">
              <Icon name="github" size={17} />
              <span class="font-mono">{PROFILE.githubHandle}</span>
              <Icon name="arrow-up-right" size={14} class="ml-auto text-ink-3" />
            </a>
          </li>
          <li>
            <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="group flex items-center gap-2.5 rounded-lg border border-hairline px-3.5 py-3 text-sm transition-colors duration-200 hover:border-accent">
              <Icon name="linkedin" size={17} />
              <span class="font-mono">{PROFILE.linkedinHandle}</span>
              <Icon name="arrow-up-right" size={14} class="ml-auto text-ink-3" />
            </a>
          </li>
        </ul>
      </div>

      <!-- CV hub -->
      <div class="reveal lg:col-span-5">
        <p class="eyebrow">{t.cvTitle}</p>
        <ul class="mt-3 grid gap-3">
          {
            t.cvCards.map((c) => (
              <li class="panel p-5">
                <p class="flex items-center justify-between font-mono text-[11px] tracking-wide text-ink-3 uppercase">
                  <span>{c.lang}</span>
                  <span class="text-ink-2">DSGVO / GDPR</span>
                </p>
                <p class="mt-2 font-display text-xl font-bold text-brand">{c.title}</p>
                <p class="mt-0.5 font-mono text-[11px] break-all text-ink-3">{c.file}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  <a href={c.href} download={c.file} class="inline-flex h-10 items-center gap-2 rounded-lg bg-brand px-4 text-sm font-semibold text-on-brand transition-opacity duration-200 hover:opacity-90">
                    <Icon name="download" />
                    {c.download}
                  </a>
                  <a href={c.href} target="_blank" rel="noopener" class="inline-flex h-10 items-center gap-2 rounded-lg border border-strong px-4 text-sm font-medium transition-colors duration-200 hover:border-brand">
                    {c.open}
                    <Icon name="arrow-up-right" size={14} />
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
        <p class="mt-3 flex items-start gap-2 text-xs leading-5 text-ink-2">
          <Icon name="lock" size={13} class="mt-1 shrink-0" />
          {t.cvNote}
        </p>
      </div>
    </div>
  </div>
</section>
