---
import Icon from './Icon.astro';
import CopyEmail from './CopyEmail.astro';
import { getDict, PROFILE, CV_ENABLED, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = getDict(lang);
const t = dict.contact;
const hero = dict.hero;
---

<section id="contact" class="py-20 md:py-28" aria-labelledby="contact-title">
  <div class="container-page">
    <div class="reveal">
      <div class="flex items-center gap-4">
        <p class="eyebrow shrink-0 text-primary">{t.eyebrow}</p>
        <span class="h-px flex-1 bg-line-strong" aria-hidden="true"></span>
      </div>

      <div class="mt-8 grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-6">
          <h2 id="contact-title" class="text-3xl font-semibold tracking-tight text-balance text-primary sm:text-5xl">{t.title}</h2>
          <p class="mt-5 max-w-xl text-base leading-7 text-pretty text-muted sm:text-lg sm:leading-8">{t.text}</p>
        </div>

        <div class="overflow-hidden rounded-xl border border-line bg-surface lg:col-span-6">
          <div class="border-b border-line p-5 sm:p-6">
            <p class="eyebrow">{t.emailLabel}</p>
            <a
              href={`mailto:${PROFILE.email}`}
              class="link-underline mt-1.5 inline-block font-mono text-base font-medium tracking-tight break-all text-primary sm:text-lg"
            >
              {PROFILE.email}
            </a>
            <div class="mt-4 flex flex-wrap gap-2">
              <CopyEmail lang={lang} />
              <a
                href={`mailto:${PROFILE.email}`}
                class="inline-flex h-11 items-center gap-2 rounded-lg bg-primary px-4 text-sm font-medium text-primary-fg transition-opacity duration-200 hover:opacity-90"
              >
                <Icon name="mail" />
                {t.emailLabel}
              </a>
            </div>
          </div>

          <div class:list={['grid', CV_ENABLED && 'sm:grid-cols-2']}>
            <div class:list={['p-5 sm:p-6', CV_ENABLED && 'border-b border-line sm:border-r sm:border-b-0']}>
              <p class="eyebrow">{t.profilesLabel}</p>
              <ul class="mt-3 flex flex-col gap-2">
                <li>
                  <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 text-sm font-medium">
                    <Icon name="github" />
                    <span class="link-underline">github.com/ajlittlebro</span>
                    <Icon name="arrow-up-right" size={14} class="text-subtle transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </a>
                </li>
                <li>
                  <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-2 text-sm font-medium">
                    <Icon name="linkedin" />
                    <span class="link-underline">linkedin.com/in/alain-tolentinoi</span>
                    <Icon name="arrow-up-right" size={14} class="text-subtle transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                  </a>
                </li>
              </ul>
            </div>
            {
              CV_ENABLED && (
                <div class="p-5 sm:p-6">
                  <p class="eyebrow">{t.cvLabel}</p>
                  <a href={hero.cvHref} download={hero.cvFile} class="group mt-3 inline-flex items-center gap-2 text-sm font-medium">
                    <Icon name="download" class="transition-transform duration-200 group-hover:translate-y-0.5" />
                    <span class="link-underline">{hero.ctaCv}</span>
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
