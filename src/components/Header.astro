---
import Icon from './Icon.astro';
import { getDict, ROUTES, SECTION_ORDER, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
}
const { lang, route } = Astro.props;
const t = getDict(lang);
const other: Lang = lang === 'de' ? 'en' : 'de';
const home = ROUTES.home[lang];
const anchor = (id: string) => (route === 'home' ? `#${id}` : `${home}#${id}`);

const links = SECTION_ORDER.map((key, i) => ({
  id: t.sections[key],
  num: String(i + 1).padStart(2, '0'),
  label: t.nav.labels[key],
}));

// "projekte:projects,…" – used by the language switch to keep the current section
const hashmap = SECTION_ORDER.map((k) => `${t.sections[k]}:${getDict(other).sections[k]}`).join(',');
const langs: { code: Lang; href: string }[] = [
  { code: 'de', href: ROUTES[route].de },
  { code: 'en', href: ROUTES[route].en },
];
---

<header class="theme-transition sticky top-0 z-50 border-b border-hairline bg-canvas/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={home} class="group flex flex-col rounded-md leading-tight" aria-label={`Alain Tolentino – ${t.nav.home}`}>
      <span class="font-mono text-sm font-semibold tracking-tight text-brand">
        AT <span class="text-workbench-ink" aria-hidden="true">//</span> ajlittlebro
      </span>
      <span class="font-mono text-[10px] tracking-wider text-ink-3 uppercase">{t.nav.brandSub}</span>
    </a>

    <nav aria-label={t.nav.primary} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          links.map((l) => (
            <li>
              <a
                href={anchor(l.id)}
                data-spy={l.id}
                class="group inline-flex items-baseline gap-1.5 rounded-md px-2.5 py-2 text-sm text-ink-2 transition-colors duration-200 hover:text-ink aria-[current=true]:text-brand"
              >
                <span class="font-mono text-[11px] text-ink-3 group-aria-[current=true]:text-workbench-ink">{l.num}</span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <div class="flex items-center rounded-md border border-hairline p-0.5 font-mono text-xs" role="group" aria-label={t.nav.lang}>
        {
          langs.map((l) => (
            <a
              href={l.href}
              hreflang={l.code}
              lang={l.code}
              data-lang-link
              data-hashmap={hashmap}
              aria-current={l.code === lang ? 'true' : undefined}
              class:list={[
                'rounded-[5px] px-2 py-1 uppercase transition-colors duration-200',
                l.code === lang ? 'bg-brand text-on-brand' : 'text-ink-2 hover:text-ink',
              ]}
            >
              {l.code}
            </a>
          ))
        }
      </div>

      <button
        type="button"
        id="theme-toggle"
        class="grid size-10 place-items-center rounded-md text-ink-2 transition-colors duration-200 hover:bg-subtle hover:text-ink"
        data-light={t.nav.themeToLight}
        data-dark={t.nav.themeToDark}
        aria-label={t.nav.themeToDark}
      >
        <Icon name="moon" size={17} class="dark:hidden" />
        <Icon name="sun" size={17} class="hidden dark:block" />
      </button>

      <button
        type="button"
        id="menu-toggle"
        class="grid size-10 place-items-center rounded-md text-ink-2 transition-colors duration-200 hover:bg-subtle hover:text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-open={t.nav.openMenu}
        data-close={t.nav.closeMenu}
        aria-label={t.nav.openMenu}
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label={t.nav.primary} class="border-t border-hairline bg-canvas lg:hidden" hidden>
    <ul class="container-page flex flex-col py-2">
      {
        links.map((l) => (
          <li>
            <a href={anchor(l.id)} class="flex items-baseline gap-3 border-b border-hairline py-3.5 text-lg font-medium last:border-0">
              <span class="font-mono text-xs text-workbench-ink">{l.num}</span>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
