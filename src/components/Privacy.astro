---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { getDict, ROUTES, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = getDict(lang);
const t = dict.privacy;

/** Split a paragraph into text and URL parts so URLs become links. */
const parts = (text: string) =>
  text.split(/(https?:\/\/\S+)/g).filter(Boolean).map((p) => ({ url: /^https?:\/\//.test(p), value: p }));
---

<Base lang={lang} route="privacy" title={`${t.title} – Alain Tolentino`} description={t.title}>
  <article class="container-page py-16 md:py-24">
    <div class="mx-auto max-w-3xl">
      <a href={ROUTES.home[lang]} class="group inline-flex items-center gap-2 text-sm text-ink-2 hover:text-ink">
        <Icon name="arrow-right" class="rotate-180 transition-transform group-hover:-translate-x-0.5" />
        {t.back}
      </a>
      <h1 class="mt-8 text-3xl font-semibold tracking-tight sm:text-4xl">{t.title}</h1>
      <p class="mt-3 font-mono text-xs text-ink-3">{t.updated}</p>

      <div class="mt-12 space-y-10">
        {
          t.sections.map((s) => (
            <section>
              <h2 class="text-lg font-semibold tracking-tight">{s.heading}</h2>
              <div class="mt-3 space-y-3">
                {s.paragraphs.map((p) => (
                  <p class="text-sm leading-7 text-ink-2">
                    {parts(p).map((part) =>
                      part.url ? (
                        <a href={part.value} target="_blank" rel="noopener noreferrer" class="break-all text-accent underline underline-offset-2">
                          {part.value}
                        </a>
                      ) : (
                        part.value
                      ),
                    )}
                  </p>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </article>
</Base>
