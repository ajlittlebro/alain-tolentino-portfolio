---
/** Education and experience as two columns, in exactly the order used in the Lebenslauf. */
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { getDict, type Lang, type TimelineItem } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang).journey;

const columns: { key: string; prefix: string; title: string; items: TimelineItem[]; shape: 'square' | 'circle' }[] = [
  { key: 'edu', prefix: 'A', title: t.eduTitle, items: t.education, shape: 'square' },
  { key: 'work', prefix: 'B', title: t.workTitle, items: t.experience, shape: 'circle' },
];
---

<section id="journey" class="border-b border-line py-20 md:py-28" aria-labelledby="journey-title">
  <div class="container-page">
    <SectionHeader id="journey-title" eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

    <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-10">
      {
        columns.map((col) => (
          <div>
            <h3 class="flex items-center gap-3 border-b border-line-strong pb-3 text-base font-semibold tracking-tight text-primary">
              <span class="font-mono text-xs font-normal text-subtle">{col.prefix}</span>
              {col.title}
              <span class="ml-auto font-mono text-xs font-normal text-subtle">{String(col.items.length).padStart(2, '0')}</span>
            </h3>

            <ol class="relative mt-6">
              <span class="absolute top-2 bottom-2 left-[7px] w-px bg-line-strong" aria-hidden="true" />
              {col.items.map((item, i) => (
                <li class="reveal relative pb-9 pl-9 last:pb-0">
                  <span
                    class:list={[
                      'absolute top-1 left-0 grid size-[15px] place-items-center border-[1.5px] border-primary bg-bg',
                      col.shape === 'square' ? 'rounded-[3px]' : 'rounded-full',
                    ]}
                    aria-hidden="true"
                  >
                    <span class:list={['size-[5px] bg-primary', col.shape === 'square' ? 'rounded-[1px]' : 'rounded-full']} />
                  </span>

                  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-subtle">
                    <span class="text-primary">
                      {col.prefix}
                      {i + 1}
                    </span>
                    <span>{item.period}</span>
                  </p>
                  <h4 class="mt-1.5 text-base font-semibold tracking-tight text-balance">{item.title}</h4>
                  <p class="mt-1 text-sm leading-6 text-muted">{item.org}</p>
                  <p class="mt-1 inline-flex items-center gap-1.5 font-mono text-[11px] text-subtle">
                    <Icon name="map-pin" size={12} />
                    {item.place}
                  </p>

                  <details class="group/d mt-2.5">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1.5 rounded-md text-sm font-medium text-accent select-none [&::-webkit-details-marker]:hidden">
                      <span class="group-open/d:hidden">{t.showDetails}</span>
                      <span class="hidden group-open/d:inline">{t.hideDetails}</span>
                      <Icon name="chevron-down" size={14} class="transition-transform duration-200 group-open/d:rotate-180" />
                    </summary>
                    <ul class="mt-3 space-y-2 rounded-xl border border-line bg-surface p-4">
                      {item.details.map((d) => (
                        <li class="relative pl-4 text-sm leading-6">
                          <span class="absolute top-[0.7rem] left-0 h-px w-2 bg-primary" aria-hidden="true" />
                          {d}
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>
