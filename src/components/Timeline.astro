---
/** 03 // Werdegang – two parallel Swiss timelines (order exactly as in the Lebenslauf) with focus dimming. */
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { getDict, type Lang, type TimelineItem } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const t = d.journey;

const columns: { prefix: string; title: string; items: TimelineItem[] }[] = [
  { prefix: 'A', title: t.eduTitle, items: t.education },
  { prefix: 'B', title: t.workTitle, items: t.experience },
];
---

<section id={d.sections.journey} class="border-b border-hairline py-20 md:py-28" aria-labelledby="journey-title">
  <div class="container-page">
    <SectionHead id="journey-title" eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

    <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-10">
      {
        columns.map((col) => (
          <div>
            <h3 class="flex items-center gap-3 border-b border-strong pb-3 text-base font-bold text-brand">
              <span class="font-mono text-xs font-medium text-workbench-ink">{col.prefix}</span>
              {col.title}
              <span class="ml-auto font-mono text-xs font-normal text-ink-3">{String(col.items.length).padStart(2, '0')}</span>
            </h3>
            <ol class="dim-group mt-5 grid gap-3">
              {col.items.map((item, i) => (
                <li class="panel dim-item reveal grid gap-1 p-4 sm:grid-cols-[9.5rem_1fr] sm:gap-5 sm:p-5">
                  <p class="font-mono text-xs leading-5 text-ink-3">
                    <span class="font-semibold text-workbench-ink">
                      {col.prefix}
                      {i + 1}
                    </span>
                    <span class="block">{item.period}</span>
                  </p>
                  <div class="min-w-0">
                    <h4 class="font-display text-[15px] leading-snug font-bold text-ink">{item.title}</h4>
                    <p class="mt-1 text-sm text-ink-2">{item.org}</p>
                    <p class="mt-1 inline-flex items-center gap-1.5 font-mono text-[11px] text-ink-3">
                      <Icon name="map-pin" size={12} />
                      {item.place}
                    </p>
                    <ul class="mt-2.5 space-y-1.5">
                      {item.details.map((x) => (
                        <li class="relative pl-4 text-[13px] leading-5 text-ink-2">
                          <span class="absolute top-[0.45rem] left-0 h-px w-2 bg-brand" aria-hidden="true" />
                          {x}
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>
