---
/** Copies the public e-mail address (logic in src/scripts/site.ts). */
import Icon from './Icon.astro';
import { getDict, PROFILE, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: className = '' } = Astro.props;
const t = getDict(lang).copyEmail;
---

<button
  type="button"
  data-copy-email={PROFILE.email}
  data-label-copied={t.copied}
  data-sr-copied={t.srCopied}
  class:list={[
    'group inline-flex h-11 items-center gap-2 rounded-lg border border-strong bg-surface px-4 text-sm font-medium text-ink transition-colors duration-200 hover:border-brand data-[copied=true]:border-available',
    className,
  ]}
>
  <Icon name="copy" class="group-data-[copied=true]:hidden" />
  <Icon name="check" class="hidden text-available group-data-[copied=true]:block" />
  <span class="copy-label">{t.copy}</span>
  <span class="sr-only" aria-live="polite" data-copy-status></span>
</button>
