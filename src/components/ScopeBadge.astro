---
import type { Project } from '../i18n';

interface Props {
  tone: Project['scopeTone'];
  label: string;
}
const { tone, label } = Astro.props;

const toneClass = {
  client: 'border-accent/40 bg-accent-soft text-accent',
  award: 'border-ok/40 text-ok',
  study: 'border-line-strong text-muted',
  ongoing: 'border-dashed border-line-strong text-muted',
}[tone];
---

<span class:list={['inline-flex items-center gap-1.5 rounded-md border px-2 py-1 font-mono text-[11px] leading-4', toneClass]}>
  {(tone === 'client' || tone === 'award') && <span class="size-1.5 rounded-full bg-current" aria-hidden="true" />}
  {label}
</span>
