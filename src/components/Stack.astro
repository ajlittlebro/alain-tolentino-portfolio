---
/** 04 // Technologie-Stack & Zertifikate – 4-block matrix with real context (no percentage bars). */
import SectionHead from './SectionHead.astro';
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const t = d.stack;
---

<section id={d.sections.stack} class="border-b border-hairline py-20 md:py-28" aria-labelledby="stack-title">
  <div class="container-page">
    <SectionHead id="stack-title" eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

    <div class="mt-14 grid overflow-hidden rounded-2xl border border-hairline bg-hairline gap-px md:grid-cols-2">
      {
        t.blocks.map((b, i) => (
          <div class:list={['bg-surface p-6 sm:p-7', i === 0 && 'md:row-span-2']}>
            <p class="flex items-baseline justify-between gap-3">
              <span class="font-mono text-xs font-semibold text-workbench-ink">0{i + 1}</span>
              <span class="eyebrow">{b.note}</span>
            </p>
            <h3 class="mt-3 text-lg font-bold text-brand">{b.title}</h3>
            <ul class:list={['mt-4 flex flex-wrap gap-2', i === 0 && 'md:gap-2.5']}>
              {b.items.map((s) => (
                <li
                  class:list={[
                    'rounded-md border font-mono leading-4',
                    i === 0 ? 'border-strong bg-subtle px-2.5 py-1.5 text-[13px] text-ink' : 'border-hairline px-2 py-1 text-[12px] text-ink-2',
                  ]}
                >
                  {s}
                </li>
              ))}
            </ul>
            {i === 0 && (
              <div class="mt-8 border-t border-hairline pt-6">
                <p class="eyebrow">{t.languagesTitle}</p>
                <dl class="mt-3 grid gap-2">
                  {t.languages.map((l) => (
                    <div class="flex flex-wrap items-baseline gap-x-3">
                      <dt class="w-20 text-sm font-semibold text-ink">{l.name}</dt>
                      <dd class="font-mono text-sm text-brand">{l.level}</dd>
                      {l.detail && <dd class="text-xs text-ink-3">{l.detail}</dd>}
                    </div>
                  ))}
                </dl>
              </div>
            )}
          </div>
        ))
      }

      <!-- Block 04: work style pillars -->
      <div class="bg-surface p-6 sm:p-7 md:col-span-2">
        <p class="flex items-baseline justify-between gap-3">
          <span class="font-mono text-xs font-semibold text-workbench-ink">04</span>
          <span class="eyebrow">{t.pillarsTitle}</span>
        </p>
        <ul class="mt-4 grid gap-5 md:grid-cols-3">
          {
            t.pillars.map((p) => (
              <li class="border-l-2 border-brand pl-4">
                <h3 class="text-[15px] font-bold text-ink">{p.title}</h3>
                <p class="mt-1.5 text-sm text-ink-2">{p.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-12">
      <div class="panel reveal p-6 lg:col-span-7">
        <h3 class="eyebrow text-brand">{t.certsTitle}</h3>
        <ul class="mt-2 divide-y divide-hairline">
          {
            t.certs.map((c) => (
              <li class="grid gap-1 py-3.5 sm:grid-cols-[1fr_auto] sm:gap-4">
                <span>
                  <span class="block text-sm font-semibold text-ink">{c.name}</span>
                  <span class="block text-xs leading-5 text-ink-2">{c.issuer}</span>
                </span>
                <span class="font-mono text-xs text-ink-3">{c.date}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="panel reveal p-6 lg:col-span-5">
        <h3 class="eyebrow text-brand">{t.awardsTitle}</h3>
        <ul class="mt-4 space-y-3">
          {
            t.awards.map((a) => (
              <li class="relative pl-5 text-sm text-ink-2">
                <span class="absolute top-[0.55rem] left-0 size-2 rotate-45 bg-workbench" aria-hidden="true" />
                {a}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
