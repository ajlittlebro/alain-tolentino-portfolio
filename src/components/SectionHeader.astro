---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
}
const { id, eyebrow, title, intro } = Astro.props;
---

<header class="reveal">
  <div class="flex items-center gap-4">
    <p class="eyebrow shrink-0 text-primary">{eyebrow}</p>
    <span class="h-px flex-1 bg-line-strong" aria-hidden="true"></span>
  </div>
  <div class="mt-6 grid gap-4 md:grid-cols-12 md:gap-8">
    <h2 id={id} class="text-3xl font-semibold tracking-tight text-balance text-primary md:col-span-7 sm:text-4xl">{title}</h2>
    {intro && <p class="max-w-xl text-base leading-7 text-pretty text-muted md:col-span-5 md:pt-1.5">{intro}</p>}
  </div>
</header>
