---
/** CASE 03 – dual panel: SVG data visualization (WME) + Colored Petri Net (SWT II). */
interface Props {
  title: string;
  desc: string;
}
const { title, desc } = Astro.props;
const uid = 'dg-tud';
const bars = [44, 70, 56, 96, 80, 62];
const base = 232;
---

<svg viewBox="0 0 540 340" role="img" aria-labelledby={`${uid}-t ${uid}-d`} class="h-auto w-full font-mono">
  <title id={`${uid}-t`}>{title}</title>
  <desc id={`${uid}-d`}>{desc}</desc>
  <defs>
    <marker id={`${uid}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0 0 10 5 0 10z" class="fill-brand"></path>
    </marker>
  </defs>

  <!-- Panel A: data visualization -->
  <rect x="10" y="14" width="252" height="312" rx="10" class="fill-surface stroke-strong"></rect>
  <text x="24" y="38" font-size="10" letter-spacing="1" class="fill-ink-3">A · WME 60 h DATA VIS</text>
  <line x1="40" y1="70" x2="40" y2={base} class="stroke-strong"></line>
  <line x1="40" y1={base} x2="244" y2={base} class="stroke-strong"></line>
  {[0.25, 0.5, 0.75].map((f) => <line x1="40" x2="244" y1={base - f * 150} y2={base - f * 150} class="stroke-hairline" stroke-dasharray="3 4" />)}
  {
    bars.map((h, i) => (
      <rect x={54 + i * 31} y={base - h} width="20" height={h} rx="2" class={i === 3 ? 'fill-accent' : 'fill-brand'} fill-opacity={i === 3 ? 1 : 0.28} />
    ))
  }
  <polyline points={bars.map((h, i) => `${64 + i * 31},${base - h - 14}`).join(' ')} class="fill-none stroke-workbench" stroke-width="1.8"></polyline>
  {bars.map((h, i) => <circle cx={64 + i * 31} cy={base - h - 14} r="3" class="fill-surface stroke-workbench" stroke-width="1.6" />)}
  <rect x="120" y="96" width="92" height="22" rx="4" class="fill-brand"></rect>
  <text x="166" y="111" text-anchor="middle" font-size="10" class="fill-on-brand">hover · tooltip</text>
  <text x="24" y="262" font-size="10" class="fill-ink-2">XML → DOM → SVG</text>
  <text x="24" y="280" font-size="10" class="fill-ink-2">HTML5 · CSS3 · JS (ES6+)</text>
  <text x="24" y="306" font-size="10" class="fill-ink-3">INF-25-Ba-PMI-WME</text>

  <!-- Panel B: Colored Petri Net -->
  <rect x="278" y="14" width="252" height="312" rx="10" class="fill-surface stroke-strong"></rect>
  <text x="292" y="38" font-size="10" letter-spacing="1" class="fill-ink-3">B · SWT II · COLORED PETRI NET</text>

  <!-- arcs -->
  <path d="M346 112 L 386 112" class="stroke-brand" stroke-width="1.4" marker-end={`url(#${uid}-a)`}></path>
  <path d="M398 112 L 446 112" class="stroke-brand" stroke-width="1.4" marker-end={`url(#${uid}-a)`}></path>
  <path d="M470 132 L 470 196" class="stroke-brand" stroke-width="1.4" marker-end={`url(#${uid}-a)`}></path>
  <path d="M458 216 L 410 216" class="stroke-brand" stroke-width="1.4" marker-end={`url(#${uid}-a)`}></path>
  <path d="M398 216 C 330 216, 326 170, 326 134" class="fill-none stroke-brand" stroke-width="1.4" marker-end={`url(#${uid}-a)`}></path>

  <!-- places -->
  <circle cx="326" cy="112" r="20" class="fill-subtle stroke-brand" stroke-width="1.6"></circle>
  <circle cx="320" cy="108" r="4" class="fill-workbench"></circle>
  <circle cx="332" cy="116" r="4" class="fill-accent"></circle>
  <circle cx="470" cy="112" r="20" class="fill-subtle stroke-brand" stroke-width="1.6"></circle>
  <circle cx="470" cy="112" r="4" class="fill-workbench"></circle>

  <!-- transitions -->
  <rect x="388" y="94" width="10" height="36" class="fill-brand"></rect>
  <rect x="398" y="198" width="10" height="36" class="fill-brand"></rect>
  <rect x="452" y="200" width="36" height="10" rx="1" class="fill-surface stroke-brand" stroke-width="1.4"></rect>

  <!-- labels -->
  <text x="326" y="84" text-anchor="middle" font-size="10" class="fill-ink">P1</text>
  <text x="470" y="84" text-anchor="middle" font-size="10" class="fill-ink">P2</text>
  <text x="393" y="86" text-anchor="middle" font-size="10" class="fill-ink">T1</text>
  <text x="403" y="250" text-anchor="middle" font-size="10" class="fill-ink">T2</text>
  <text x="470" y="230" text-anchor="middle" font-size="9" class="fill-ink-3">queue</text>

  <circle cx="300" cy="276" r="4" class="fill-workbench"></circle>
  <text x="310" y="280" font-size="10" class="fill-ink-2">token · colour set A</text>
  <circle cx="300" cy="296" r="4" class="fill-accent"></circle>
  <text x="310" y="300" font-size="10" class="fill-ink-2">token · colour set B</text>
</svg>
