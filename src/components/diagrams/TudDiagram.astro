---
/** Schematic: data-driven SVG infographic + a small Petri net (places, transitions, tokens). */
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';
const label = de
  ? 'Schema: datengestützte Web-Infografik als SVG-Diagramm und ein Petri-Netz mit Stellen, Transitionen und Marken zur Modellierung nebenläufiger Systeme.'
  : 'Schematic: data-driven web infographic as an SVG chart and a Petri net with places, transitions and tokens for modeling concurrent systems.';

const bars = [
  { x: 52, h: 40 },
  { x: 82, h: 64 },
  { x: 112, h: 50 },
  { x: 142, h: 84 },
  { x: 172, h: 70 },
];
const base = 176;
---

<svg viewBox="0 0 400 250" role="img" aria-label={label} class="h-auto w-full font-mono">
  <defs>
    <marker id="tud-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 10 5 0 10z" class="fill-primary"></path>
    </marker>
  </defs>

  <!-- Infographic -->
  <text x="16" y="32" font-size="9.5" letter-spacing="0.8" class="fill-subtle">{de ? 'WEB-INFOGRAFIK' : 'WEB INFOGRAPHIC'}</text>
  <rect x="16" y="42" width="204" height="152" rx="6" class="fill-surface stroke-line-strong"></rect>
  <line x1="38" y1="58" x2="38" y2={base} class="stroke-line-strong"></line>
  <line x1="38" y1={base} x2="206" y2={base} class="stroke-line-strong"></line>
  {
    bars.map((b, i) => (
      <rect
        x={b.x}
        y={base - b.h}
        width="18"
        height={b.h}
        rx="2"
        class={i === 3 ? 'fill-accent' : 'fill-accent'}
        fill-opacity={i === 3 ? 1 : 0.22}
      />
    ))
  }
  <polyline
    points={bars.map((b) => `${b.x + 9},${base - b.h - 10}`).join(' ')}
    class="fill-none stroke-primary"
    stroke-width="1.5"
  ></polyline>
  {bars.map((b) => <circle cx={b.x + 9} cy={base - b.h - 10} r="2.6" class="fill-surface stroke-primary" stroke-width="1.5" />)}
  <!-- tooltip hint for interactivity -->
  <rect x="114" y="50" width="76" height="18" rx="3" class="fill-primary"></rect>
  <text x="152" y="63" text-anchor="middle" font-size="9.5" class="fill-primary-fg">hover · data</text>
  <text x="16" y="214" font-size="9.5" class="fill-muted">HTML5 · CSS3 · SVG · JS · XML</text>

  <!-- Petri net -->
  <text x="246" y="32" font-size="9.5" letter-spacing="0.8" class="fill-subtle">{de ? 'PETRI-NETZ · CPN IDE' : 'PETRI NET · CPN IDE'}</text>

  <!-- arcs -->
  <path d="M274 82 L 309 82" class="stroke-primary" stroke-width="1.3" marker-end="url(#tud-arrow)"></path>
  <path d="M318 88 L 357 116" class="stroke-primary" stroke-width="1.3" marker-end="url(#tud-arrow)"></path>
  <path d="M357 134 L 318 162" class="stroke-primary" stroke-width="1.3" marker-end="url(#tud-arrow)"></path>
  <path d="M309 168 L 274 168" class="stroke-primary" stroke-width="1.3" marker-end="url(#tud-arrow)"></path>
  <path d="M262 156 L 262 133" class="stroke-primary" stroke-width="1.3" marker-end="url(#tud-arrow)"></path>
  <path d="M262 117 L 262 95" class="stroke-primary" stroke-width="1.3" marker-end="url(#tud-arrow)"></path>

  <!-- places -->
  <circle cx="262" cy="82" r="12" class="fill-surface stroke-primary" stroke-width="1.5"></circle>
  <circle cx="262" cy="82" r="3.5" class="fill-accent"></circle>
  <circle cx="368" cy="125" r="12" class="fill-surface stroke-primary" stroke-width="1.5"></circle>
  <circle cx="364" cy="125" r="3" class="fill-accent"></circle>
  <circle cx="372" cy="125" r="3" class="fill-accent"></circle>
  <circle cx="262" cy="168" r="12" class="fill-surface stroke-primary" stroke-width="1.5"></circle>

  <!-- transitions -->
  <rect x="311" y="70" width="7" height="24" class="fill-primary"></rect>
  <rect x="311" y="156" width="7" height="24" class="fill-primary"></rect>
  <rect x="250" y="122" width="24" height="7" class="fill-primary"></rect>

  <!-- labels -->
  <text x="244" y="64" font-size="9" class="fill-subtle">P1</text>
  <text x="378" y="104" font-size="9" class="fill-subtle">P2</text>
  <text x="244" y="196" font-size="9" class="fill-subtle">P3</text>
  <text x="322" y="66" font-size="9" class="fill-subtle">T1</text>
  <text x="322" y="192" font-size="9" class="fill-subtle">T2</text>
  <text x="280" y="129" font-size="9" class="fill-subtle">T3</text>
  <text x="246" y="214" font-size="9.5" class="fill-muted">{de ? 'nebenläufige Systeme' : 'concurrent systems'}</text>
</svg>
