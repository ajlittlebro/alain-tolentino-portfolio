---
/** CASE 01 – three-layer architecture: React client ⇄ Express REST API ⇄ MySQL + Cloudinary. */
interface Props {
  title: string;
  desc: string;
}
const { title, desc } = Astro.props;
const uid = 'dg-shop';
---

<svg viewBox="0 0 540 340" role="img" aria-labelledby={`${uid}-t ${uid}-d`} class="h-auto w-full font-mono">
  <title id={`${uid}-t`}>{title}</title>
  <desc id={`${uid}-d`}>{desc}</desc>
  <defs>
    <marker id={`${uid}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 10 5 0 10z" class="fill-brand"></path>
    </marker>
  </defs>

  <!-- layer captions -->
  <text x="16" y="22" font-size="10" letter-spacing="1" class="fill-ink-3">L1 · CLIENT</text>
  <text x="200" y="22" font-size="10" letter-spacing="1" class="fill-ink-3">L2 · REST API</text>
  <text x="378" y="22" font-size="10" letter-spacing="1" class="fill-ink-3">L3 · PERSISTENCE</text>

  <!-- L1 -->
  <rect x="10" y="32" width="164" height="296" rx="10" class="fill-subtle stroke-strong" stroke-dasharray="4 4"></rect>
  <text x="22" y="54" font-size="12.5" font-weight="600" class="fill-ink font-sans">React 18 · Vite</text>

  <rect x="22" y="66" width="140" height="92" rx="7" class="fill-surface stroke-brand" stroke-width="1.5"></rect>
  <text x="34" y="88" font-size="13" font-weight="700" class="fill-ink font-sans">Storefront</text>
  <text x="34" y="107" font-size="10" class="fill-ink-2">Multi-Filter</text>
  <text x="34" y="122" font-size="10" class="fill-ink-2">price · platform</text>
  <text x="34" y="137" font-size="10" class="fill-ink-2">genre · search</text>

  <rect x="22" y="168" width="140" height="92" rx="7" class="fill-surface stroke-brand" stroke-width="1.5"></rect>
  <text x="34" y="190" font-size="13" font-weight="700" class="fill-ink font-sans">Admin CRUD</text>
  <text x="34" y="209" font-size="10" class="fill-ink-2">TanStack Table v8</text>
  <text x="34" y="224" font-size="10" class="fill-ink-2">React Hook Form</text>
  <text x="34" y="239" font-size="10" class="fill-ink-2">sort · filter · page</text>

  <rect x="22" y="272" width="140" height="44" rx="7" class="fill-accent-soft stroke-accent"></rect>
  <text x="92" y="292" text-anchor="middle" font-size="12" font-weight="700" class="fill-accent">13 Contexts</text>
  <text x="92" y="306" text-anchor="middle" font-size="9.5" class="fill-ink-2">auth · cart · wishlist</text>

  <!-- L1 ⇄ L2 -->
  <path d="M164 112 C 182 112, 182 140, 196 140" class="fill-none stroke-brand" stroke-width="1.4" marker-start={`url(#${uid}-a)`} marker-end={`url(#${uid}-a)`}></path>
  <path d="M164 214 C 182 214, 182 190, 196 190" class="fill-none stroke-brand" stroke-width="1.4" marker-start={`url(#${uid}-a)`} marker-end={`url(#${uid}-a)`}></path>
  <text x="181" y="168" text-anchor="middle" font-size="8.5" class="fill-ink-3">JSON</text>

  <!-- L2 -->
  <rect x="198" y="66" width="150" height="250" rx="10" class="fill-surface stroke-brand" stroke-width="1.6"></rect>
  <text x="273" y="90" text-anchor="middle" font-size="13.5" font-weight="700" class="fill-ink font-sans">Express.js</text>
  <text x="273" y="106" text-anchor="middle" font-size="10" class="fill-ink-2">Node.js · REST</text>
  {
    [
      { y: 122, label: 'JWT Cookie Auth' },
      { y: 170, label: 'Zod Validator' },
      { y: 218, label: 'bcryptjs' },
    ].map((n) => (
      <g>
        <rect x="212" y={n.y} width="122" height="36" rx="6" class="fill-subtle stroke-strong" />
        <circle cx="226" cy={n.y + 18} r="4" class="fill-workbench" />
        <text x="238" y={n.y + 22} font-size="10.5" class="fill-ink">{n.label}</text>
      </g>
    ))
  }
  <text x="273" y="282" text-anchor="middle" font-size="9.5" class="fill-ink-3">authRequired</text>
  <text x="273" y="297" text-anchor="middle" font-size="9.5" class="fill-ink-3">connection pool</text>

  <!-- L2 ⇄ L3 -->
  <path d="M348 140 L 380 140" class="fill-none stroke-brand" stroke-width="1.4" marker-start={`url(#${uid}-a)`} marker-end={`url(#${uid}-a)`}></path>
  <text x="364" y="132" text-anchor="middle" font-size="8.5" class="fill-ink-3">SQL</text>
  <path d="M348 262 L 380 262" class="fill-none stroke-brand" stroke-width="1.4" marker-end={`url(#${uid}-a)`}></path>
  <text x="364" y="254" text-anchor="middle" font-size="8.5" class="fill-ink-3">HTTPS</text>

  <!-- L3: MySQL cylinder -->
  <path d="M384 86 v 108 a 70 14 0 0 0 140 0 v -108" class="fill-surface stroke-brand" stroke-width="1.5"></path>
  <ellipse cx="454" cy="86" rx="70" ry="14" class="fill-subtle stroke-brand" stroke-width="1.5"></ellipse>
  <text x="454" y="124" text-anchor="middle" font-size="14" font-weight="700" class="fill-ink font-sans">MySQL</text>
  <text x="454" y="146" text-anchor="middle" font-size="10.5" class="fill-ink-2">15 tables</text>
  <rect x="404" y="158" width="100" height="22" rx="5" class="fill-workbench" fill-opacity="0.16"></rect>
  <text x="454" y="173" text-anchor="middle" font-size="10" class="fill-ink">18 triggers · TRIM</text>

  <!-- L3: Cloudinary -->
  <rect x="384" y="236" width="140" height="56" rx="7" class="fill-surface stroke-brand" stroke-width="1.5"></rect>
  <text x="454" y="260" text-anchor="middle" font-size="13" font-weight="700" class="fill-ink font-sans">Cloudinary</text>
  <text x="454" y="278" text-anchor="middle" font-size="10" class="fill-ink-2">image upload API</text>
</svg>
