---
/** Schematic: React storefront + admin ⇄ Express REST API (JWT) ⇄ MySQL */
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';
const label = de
  ? 'Schema: React-Frontend mit Storefront und Admin-CRUD kommuniziert über eine REST API mit JWT (Express.js, Node.js) mit einer MySQL-Datenbank.'
  : 'Schematic: React frontend with storefront and admin CRUD communicates through a REST API with JWT (Express.js, Node.js) with a MySQL database.';
---

<svg viewBox="0 0 400 250" role="img" aria-label={label} class="h-auto w-full font-mono">
  <defs>
    <marker id="shop-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 10 5 0 10z" class="fill-primary"></path>
    </marker>
  </defs>

  <!-- Client tier -->
  <rect x="10" y="18" width="152" height="214" rx="8" class="fill-none stroke-line-strong" stroke-dasharray="4 4"></rect>
  <text x="22" y="36" font-size="9.5" letter-spacing="0.8" class="fill-subtle">CLIENT · REACT</text>

  <rect x="22" y="46" width="128" height="86" rx="6" class="fill-surface stroke-primary" stroke-width="1.5"></rect>
  <text x="34" y="70" font-size="13" font-weight="600" class="fill-fg font-sans">Storefront</text>
  <text x="34" y="90" font-size="10" class="fill-muted">{de ? 'Katalog · Filter' : 'Catalog · filters'}</text>
  <text x="34" y="105" font-size="10" class="fill-muted">Cart · Wishlist</text>
  <text x="34" y="120" font-size="10" class="fill-accent">Context API</text>

  <rect x="22" y="142" width="128" height="78" rx="6" class="fill-surface stroke-primary" stroke-width="1.5"></rect>
  <text x="34" y="166" font-size="13" font-weight="600" class="fill-fg font-sans">Admin-CRUD</text>
  <text x="34" y="186" font-size="10" class="fill-muted">Dashboard</text>
  <text x="34" y="201" font-size="10" class="fill-muted">{de ? 'rollengeschützt' : 'role-protected'}</text>

  <!-- HTTP links -->
  <text x="238" y="66" text-anchor="middle" font-size="9.5" letter-spacing="0.6" class="fill-subtle">HTTP · JSON</text>
  <path d="M150 90 C 170 90, 170 112, 192 112" class="fill-none stroke-primary" stroke-width="1.4" marker-start="url(#shop-arrow)" marker-end="url(#shop-arrow)"></path>
  <path d="M150 180 C 170 180, 170 142, 192 142" class="fill-none stroke-primary" stroke-width="1.4" marker-start="url(#shop-arrow)" marker-end="url(#shop-arrow)"></path>

  <!-- API tier -->
  <rect x="194" y="78" width="92" height="96" rx="6" class="fill-surface stroke-primary" stroke-width="1.5"></rect>
  <text x="240" y="102" text-anchor="middle" font-size="13" font-weight="600" class="fill-fg font-sans">REST API</text>
  <text x="240" y="121" text-anchor="middle" font-size="10" class="fill-muted">Express.js</text>
  <text x="240" y="135" text-anchor="middle" font-size="10" class="fill-muted">Node.js</text>
  <rect x="210" y="146" width="60" height="18" rx="4" class="fill-accent-soft stroke-accent"></rect>
  <text x="240" y="159" text-anchor="middle" font-size="10" class="fill-accent">JWT</text>

  <!-- SQL link -->
  <text x="301" y="118" text-anchor="middle" font-size="9.5" class="fill-subtle">SQL</text>
  <path d="M288 126 L 314 126" class="fill-none stroke-primary" stroke-width="1.4" marker-start="url(#shop-arrow)" marker-end="url(#shop-arrow)"></path>

  <!-- Database -->
  <path d="M318 94 v 66 a 35 9 0 0 0 70 0 v -66" class="fill-surface stroke-primary" stroke-width="1.5"></path>
  <ellipse cx="353" cy="94" rx="35" ry="9" class="fill-surface-2 stroke-primary" stroke-width="1.5"></ellipse>
  <text x="353" y="128" text-anchor="middle" font-size="13" font-weight="600" class="fill-fg font-sans">MySQL</text>
  <text x="353" y="146" text-anchor="middle" font-size="9.5" class="fill-muted">{de ? 'Produkte' : 'Products'}</text>
  <text x="353" y="159" text-anchor="middle" font-size="9.5" class="fill-muted">{de ? 'Nutzer' : 'Users'}</text>
</svg>
