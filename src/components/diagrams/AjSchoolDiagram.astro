---
/** CASE 02 – static architecture & conversion funnel → +15 %. */
interface Props {
  title: string;
  desc: string;
  metric: string;
}
const { title, desc, metric } = Astro.props;
const uid = 'dg-aj';
const stages = [
  { y: 40, w: 440, title: 'Astro Static Generation + Tailwind CSS', sub: 'mobile-first UI · View Transitions' },
  { y: 112, w: 380, title: 'Course Level Routing & Lead Capture', sub: '/courses · /contact' },
  { y: 184, w: 320, title: 'Formspree API + Firebase (NoSQL)', sub: 'forms · storage' },
];
---

<svg viewBox="0 0 540 340" role="img" aria-labelledby={`${uid}-t ${uid}-d`} class="h-auto w-full font-mono">
  <title id={`${uid}-t`}>{title}</title>
  <desc id={`${uid}-d`}>{desc}</desc>
  <defs>
    <marker id={`${uid}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M0 0 10 5 0 10z" class="fill-brand"></path>
    </marker>
  </defs>

  <text x="16" y="24" font-size="10" letter-spacing="1" class="fill-ink-3">BUILD → ROUTE → CAPTURE → IMPACT</text>

  {
    stages.map((s, i) => {
      const x = (540 - s.w) / 2;
      return (
        <g>
          <rect x={x} y={s.y} width={s.w} height="52" rx="8" class="fill-surface stroke-brand" stroke-width="1.5" />
          <rect x={x} y={s.y} width="34" height="52" rx="8" class="fill-subtle" />
          <text x={x + 17} y={s.y + 31} text-anchor="middle" font-size="11" font-weight="600" class="fill-workbench-ink">{`0${i + 1}`}</text>
          <text x={x + 48} y={s.y + 23} font-size="12.5" font-weight="700" class="fill-ink font-sans">{s.title}</text>
          <text x={x + 48} y={s.y + 40} font-size="10" class="fill-ink-2">{s.sub}</text>
          <path d={`M270 ${s.y + 52} L 270 ${s.y + 70}`} class="stroke-brand" stroke-width="1.4" marker-end={`url(#${uid}-a)`} />
        </g>
      );
    })
  }

  <!-- Impact node -->
  <rect x="110" y="258" width="320" height="68" rx="10" class="fill-accent-soft stroke-accent" stroke-width="1.8"></rect>
  <circle cx="110" cy="292" r="5" class="fill-workbench"></circle>
  <circle cx="430" cy="292" r="5" class="fill-workbench"></circle>
  <text x="270" y="291" text-anchor="middle" font-size="24" font-weight="800" class="fill-accent font-sans">{metric}</text>
  <text x="270" y="312" text-anchor="middle" font-size="9.5" class="fill-ink-2">digital course inquiries &amp; projected enrollments</text>
</svg>
