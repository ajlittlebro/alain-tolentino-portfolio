---
/** Schematic: static Astro + Tailwind site → Firebase Hosting / Firebase NoSQL / Formspree → +15 %. */
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const de = lang === 'de';
const label = de
  ? 'Schema: responsives Webportal mit Astro und Tailwind CSS, ausgeliefert über Firebase Hosting, mit Firebase (NoSQL) und Formspree für Anfrageformulare; Ergebnis plus 15 Prozent Kursanfragen und prognostizierte Einschreibungen.'
  : 'Schematic: responsive web portal built with Astro and Tailwind CSS, delivered via Firebase Hosting, with Firebase (NoSQL) and Formspree for inquiry forms; outcome plus 15 percent course inquiries and projected enrollments.';

const services = [
  { y: 26, title: 'Firebase Hosting', sub: de ? 'Auslieferung' : 'Delivery' },
  { y: 82, title: 'Firebase · NoSQL', sub: de ? 'Daten' : 'Data' },
  { y: 138, title: 'Formspree', sub: de ? 'Anfrageformulare' : 'Inquiry forms' },
];
---

<svg viewBox="0 0 400 250" role="img" aria-label={label} class="h-auto w-full font-mono">
  <defs>
    <marker id="aj-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
      <path d="M0 0 10 5 0 10z" class="fill-primary"></path>
    </marker>
  </defs>

  <!-- Browser frame -->
  <rect x="12" y="26" width="176" height="156" rx="7" class="fill-surface stroke-primary" stroke-width="1.5"></rect>
  <path d="M12 44 H 188" class="stroke-line-strong"></path>
  <circle cx="24" cy="35" r="2.6" class="fill-line-strong"></circle>
  <circle cx="33" cy="35" r="2.6" class="fill-line-strong"></circle>
  <circle cx="42" cy="35" r="2.6" class="fill-line-strong"></circle>
  <text x="54" y="38.5" font-size="8.5" class="fill-subtle">theajschool.web.app</text>

  <!-- wireframe -->
  <rect x="24" y="54" width="60" height="7" rx="2" class="fill-primary"></rect>
  <rect x="140" y="54" width="36" height="7" rx="2" class="fill-line-strong"></rect>
  <rect x="24" y="70" width="152" height="40" rx="4" class="fill-surface-2"></rect>
  <rect x="32" y="80" width="80" height="6" rx="2" class="fill-line-strong"></rect>
  <rect x="32" y="92" width="50" height="10" rx="3" class="fill-accent"></rect>
  <rect x="24" y="118" width="72" height="26" rx="4" class="fill-surface-2"></rect>
  <rect x="104" y="118" width="72" height="26" rx="4" class="fill-surface-2"></rect>
  <text x="100" y="168" text-anchor="middle" font-size="12" font-weight="600" class="fill-fg font-sans">Astro + Tailwind CSS</text>

  <!-- Services -->
  {
    services.map((s) => (
      <g>
        <path d={`M188 ${s.y + 20} C 205 ${s.y + 20}, 205 ${s.y + 20}, 222 ${s.y + 20}`} class="stroke-primary" stroke-width="1.3" marker-end="url(#aj-arrow)" />
        <rect x="224" y={s.y} width="164" height="40" rx="6" class="fill-surface stroke-primary" stroke-width="1.5" />
        <text x="236" y={s.y + 17} font-size="12" font-weight="600" class="fill-fg font-sans">{s.title}</text>
        <text x="236" y={s.y + 31} font-size="9.5" class="fill-muted">{s.sub}</text>
      </g>
    ))
  }

  <!-- Outcome -->
  <rect x="12" y="196" width="376" height="38" rx="6" class="fill-accent-soft stroke-accent"></rect>
  <text x="26" y="221" font-size="17" font-weight="700" class="fill-accent font-sans">{de ? '+15 %' : '+15%'}</text>
  <text x="88" y="219" font-size="9.5" class="fill-muted">{de ? 'Kursanfragen & prognostizierte Einschreibungen' : 'course inquiries & projected enrollments'}</text>
</svg>
