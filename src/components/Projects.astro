---
import SectionHead from './SectionHead.astro';
import CaseStudy from './CaseStudy.astro';
import ArchiveCard from './ArchiveCard.astro';
import Icon from './Icon.astro';
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const t = d.projects;
---

<section id={d.sections.projects} class="border-b border-hairline py-20 md:py-28" aria-labelledby="projects-title">
  <div class="container-page">
    <SectionHead id="projects-title" eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

    <p class="eyebrow mt-16 mb-5 flex items-center gap-3"><span class="h-px w-6 bg-workbench" aria-hidden="true"></span>{t.tier1}</p>
    <div class="grid gap-8">
      {t.cases.map((c) => <CaseStudy item={c} labels={t.labels} />)}
    </div>

    <p class="eyebrow mt-20 mb-5 flex items-center gap-3"><span class="h-px w-6 bg-workbench" aria-hidden="true"></span>{t.tier2}</p>
    <p class="mb-6 flex items-start gap-3 rounded-xl border border-hairline bg-surface px-4 py-3 text-sm text-ink-2">
      <Icon name="lock" size={16} class="mt-1 shrink-0 text-brand" />
      <span>{t.privacyNote}</span>
    </p>
    <div class="dim-group grid gap-6 md:grid-cols-2">
      {t.archive.map((a) => <ArchiveCard item={a} />)}
    </div>
  </div>
</section>
