---
/** Level-2 live demo / engineering archive card. */
import { Image } from 'astro:assets';
import ProjectLinks from './ProjectLinks.astro';
import type { ArchiveItem } from '../i18n';
import event from '../assets/demos/event.webp';
import boardgame from '../assets/demos/boardgame.webp';
import sustainability from '../assets/demos/sustainability.webp';

interface Props {
  item: ArchiveItem;
}
const { item: a } = Astro.props;
const shots = { event, boardgame, sustainability };
const shot = a.shot ? shots[a.shot] : undefined;
---

<article class="panel dim-item reveal flex flex-col overflow-hidden" aria-labelledby={`arch-${a.id}`}>
  {
    shot ? (
      <div class="border-b border-hairline bg-subtle p-3">
        <div class="overflow-hidden rounded-md border border-hairline">
          <div class="flex items-center gap-1.5 border-b border-hairline bg-surface px-2.5 py-1.5" aria-hidden="true">
            <span class="size-2 rounded-full bg-strong" />
            <span class="size-2 rounded-full bg-strong" />
            <span class="size-2 rounded-full bg-workbench" />
          </div>
          <Image src={shot} alt={a.shotAlt ?? ''} width={480} height={300} loading="lazy" class="block aspect-[16/10] h-auto w-full object-cover object-top" />
        </div>
      </div>
    ) : (
      <div class="blueprint flex aspect-[16/10] flex-col justify-end border-b border-hairline bg-subtle p-5" aria-hidden="true">
        <p class="font-mono text-[11px] leading-5 text-ink-3">
          &gt; SISDON.exe — WinForms · OleDb · MS Access
          <br />
          &gt; POS · Inventario · Clientes · Usuarios
        </p>
      </div>
    )
  }

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[11px] text-ink-3">
      <span class="font-semibold text-workbench-ink">{a.index}</span>
      <span aria-hidden="true">/</span>
      <span>{a.period}</span>
      <span aria-hidden="true">/</span>
      <span>{a.place}</span>
    </p>
    <h3 id={`arch-${a.id}`} class="mt-3 font-display text-lg leading-snug font-bold tracking-tight text-balance text-brand">{a.title}</h3>
    <p class="mt-2.5 text-sm text-pretty text-ink-2">{a.summary}</p>
    {
      a.facts && (
        <ul class="mt-4 grid gap-1.5">
          {a.facts.map((f) => (
            <li class="relative pl-4 text-[13px] leading-5 text-ink-2">
              <span class="absolute top-[0.45rem] left-0 h-px w-2 bg-workbench" aria-hidden="true" />
              {f}
            </li>
          ))}
        </ul>
      )
    }
    <ul class="mt-4 flex flex-wrap gap-1.5">
      {a.stack.map((s) => <li class="rounded-md border border-hairline bg-subtle px-2 py-0.5 font-mono text-[11px] leading-4 text-ink-2">{s}</li>)}
    </ul>
    <div class="mt-auto pt-5">
      <ProjectLinks links={a.links} />
    </div>
  </div>
</article>
