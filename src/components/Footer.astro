---
import Icon from './Icon.astro';
import { getDict, PROFILE, ROUTES, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang).footer;
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col gap-6 py-8 text-sm text-muted md:flex-row md:items-center md:justify-between">
    <div class="flex flex-col gap-1">
      <p>© {year} {t.rights}</p>
      <p class="font-mono text-xs text-subtle">{t.built} · Dresden</p>
    </div>
    <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <li><a href={ROUTES.privacy[lang]} class="link-underline hover:text-fg">{t.privacy}</a></li>
      <li><a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="link-underline hover:text-fg">GitHub</a></li>
      <li><a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="link-underline hover:text-fg">LinkedIn</a></li>
      <li>
        <a href="#main" class="inline-flex items-center gap-1.5 hover:text-fg" aria-label={t.top}>
          <Icon name="arrow-up" size={14} />
          <span class="hidden sm:inline">{t.top}</span>
        </a>
      </li>
    </ul>
  </div>
</footer>
