---
/** Small live-demo card (section C). */
import ProjectLinks from './ProjectLinks.astro';
import type { DemoProject } from '../i18n';

interface Props {
  demo: DemoProject;
  index: number;
}
const { demo: d, index } = Astro.props;
---

<article class="card reveal group/card flex flex-col p-5" aria-labelledby={`demo-${d.id}`}>
  <div class="flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-subtle">
    <span><span class="text-primary transition-colors duration-200 group-hover/card:text-accent">C-{String(index + 1).padStart(2, '0')}</span> / {d.context}</span>
    <span class="rounded-md border border-line-strong px-1.5 py-0.5">{d.scope}</span>
  </div>
  <h3 id={`demo-${d.id}`} class="mt-4 text-base font-semibold tracking-tight text-balance text-primary">{d.title}</h3>
  <p class="mt-2 text-sm leading-6 text-pretty text-muted">{d.text}</p>
  <ul class="mt-4 flex flex-wrap gap-1.5">
    {d.stack.map((s) => <li class="rounded-md border border-line bg-surface-2 px-2 py-0.5 font-mono text-[11px] leading-4 text-muted">{s}</li>)}
  </ul>
  <div class="mt-auto pt-5">
    <ProjectLinks links={d.links} />
  </div>
</article>
