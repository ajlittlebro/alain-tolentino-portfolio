---
import SectionHeader from './SectionHeader.astro';
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang).skills;
---

<section id="skills" class="border-b border-line py-20 md:py-28" aria-labelledby="skills-title">
  <div class="container-page">
    <SectionHeader id="skills-title" eyebrow={t.eyebrow} title={t.title} intro={t.intro} />

    <div class="mt-12 grid gap-5 md:mt-16 lg:grid-cols-12">
      <!-- Core focus -->
      <div class="card reveal p-6 sm:p-8 lg:col-span-7">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-lg font-semibold tracking-tight text-primary">{t.focus.title}</h3>
          <span class="rounded-md border border-accent/40 bg-accent-soft px-2 py-0.5 font-mono text-[11px] text-accent">{t.focus.note}</span>
        </div>
        <ul class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3">
          {
            t.focus.items.map((s) => (
              <li class="rounded-lg border border-line bg-surface-2 px-3 py-2.5 text-sm font-medium transition-colors hover:border-line-strong transition-colors duration-200">
                {s}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Secondary groups -->
      <div class="grid gap-5 lg:col-span-5">
        {
          t.groups.map((g) => (
            <div class="card reveal p-6">
              <h3 class="text-sm font-semibold tracking-tight text-primary">{g.title}</h3>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {g.items.map((s) => (
                  <li class="rounded-md border border-line px-2 py-1 font-mono text-[11px] leading-4 text-muted">{s}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <!-- Languages -->
      <div class="card reveal p-6 sm:p-8 lg:col-span-5">
        <h3 class="text-lg font-semibold tracking-tight text-primary">{t.languagesTitle}</h3>
        <ul class="mt-6 space-y-5">
          {
            t.languages.map((l) => (
              <li>
                <div class="flex items-baseline justify-between gap-3">
                  <span class="text-sm font-medium">{l.name}</span>
                  <span class="font-mono text-xs text-muted">{l.level}</span>
                </div>
                <div class="mt-2 h-1 overflow-hidden rounded-full bg-surface-2" aria-hidden="true">
                  <div class="h-full rounded-full bg-primary" style={`width:${l.value}%`} />
                </div>
                {l.detail && <p class="mt-1.5 text-xs text-subtle">{l.detail}</p>}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Certifications -->
      <div class="card reveal p-6 sm:p-8 lg:col-span-7">
        <h3 class="text-lg font-semibold tracking-tight text-primary">{t.certsTitle}</h3>
        <ul class="mt-4 divide-y divide-line">
          {
            t.certs.map((c) => (
              <li class="grid gap-1 py-4 last:pb-0 sm:grid-cols-[1fr_auto] sm:gap-4">
                <div>
                  <p class="text-sm font-medium">{c.name}</p>
                  <p class="mt-1 text-xs leading-5 text-muted">
                    {c.issuer} · {c.detail}
                  </p>
                </div>
                <span class="font-mono text-xs text-subtle sm:pt-0.5">{c.date}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Awards -->
      <div class="card reveal p-6 sm:p-8 lg:col-span-5">
        <h3 class="text-lg font-semibold tracking-tight text-primary">{t.awardsTitle}</h3>
        <ul class="mt-4 space-y-3">
          {
            t.awards.map((a) => (
              <li class="relative pl-5 text-sm leading-6">
                <span class="absolute top-[0.55rem] left-0 size-1.5 rounded-full bg-accent" aria-hidden="true" />
                {a}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Work style -->
      <div class="card reveal p-6 sm:p-8 lg:col-span-7">
        <h3 class="text-lg font-semibold tracking-tight text-primary">{t.workStyleTitle}</h3>
        <ul class="mt-4 grid gap-5 sm:grid-cols-3">
          {
            t.workStyle.map((w) => (
              <li>
                <p class="text-sm font-medium">{w.title}</p>
                <p class="mt-1.5 text-xs leading-5 text-muted">{w.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
