---
/** 02 // Über mich & Digitale Werkbank – asymmetric 3-panel bento grid. */
import SectionHead from './SectionHead.astro';
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const t = d.about;
---

<section id={d.sections.about} class="border-b border-hairline py-20 md:py-28" aria-labelledby="about-title">
  <div class="container-page">
    <SectionHead id="about-title" eyebrow={t.eyebrow} title={t.title} />

    <div class="mt-14 grid gap-5 lg:grid-cols-12">
      <!-- Panel 1: story -->
      <article class="panel reveal flex flex-col p-6 sm:p-8 lg:col-span-7 lg:row-span-2">
        <p class="eyebrow flex items-center gap-2"><span class="size-1.5 rounded-full bg-workbench" aria-hidden="true"></span>{t.story.label}</p>
        <div class="mt-5 space-y-4">
          {t.story.paragraphs.map((p, i) => <p class:list={['text-pretty', i === 0 ? 'text-lg leading-8 text-ink' : 'text-ink-2']}>{p}</p>)}
        </div>
        <p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-hairline pt-5 lg:mt-auto font-mono text-[11px] tracking-wide text-ink-3 uppercase">
          <span>IIES · Reynosa</span>
          <span class="h-px w-6 bg-strong" aria-hidden="true"></span>
          <span>UANL · Monterrey</span>
          <span class="h-px w-6 bg-strong" aria-hidden="true"></span>
          <span>interDaF · Leipzig</span>
          <span class="h-px w-6 bg-strong" aria-hidden="true"></span>
          <span class="text-brand">TU Dresden</span>
        </p>
      </article>

      <!-- Panel 2: workbench lab sheet -->
      <article class="panel reveal overflow-hidden lg:col-span-5">
        <div class="flex items-center justify-between border-b border-hairline px-5 py-3">
          <p class="eyebrow">{t.bench.label}</p>
          <span class="font-mono text-[11px] text-workbench-ink">{t.bench.term}</span>
        </div>
        <ul class="divide-y divide-hairline">
          {
            t.bench.modules.map((m) => (
              <li class="grid grid-cols-[4.25rem_1fr] gap-3 px-5 py-4">
                <span class="font-mono text-xs font-semibold text-brand">{m.code}</span>
                <span>
                  <span class="block text-sm font-semibold text-ink">{m.name}</span>
                  <span class="block text-xs leading-5 text-ink-2">{m.focus}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </article>

      <!-- Panel 3: communication & beyond the terminal -->
      <article class="panel reveal p-6 lg:col-span-5">
        <p class="eyebrow">{t.comms.label}</p>
        <div class="mt-3 space-y-3">
          {t.comms.paragraphs.map((p) => <p class="text-sm text-pretty text-ink-2">{p}</p>)}
        </div>
        <p class="eyebrow mt-6">{t.comms.interestsLabel}</p>
        <ul class="mt-2.5 flex flex-wrap gap-1.5">
          {t.comms.interests.map((i) => <li class="rounded-full border border-strong px-3 py-1 text-xs text-ink-2">{i}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>
