---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import Icon from './Icon.astro';
import { getDict, PROFILE, CV_ENABLED, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang).hero;
---

<section class="relative overflow-hidden border-b border-line" aria-labelledby="hero-title">
  <!-- Subtle engineering grid -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.5] [background-image:linear-gradient(var(--line)_1px,transparent_1px),linear-gradient(90deg,var(--line)_1px,transparent_1px)] [background-size:56px_56px] [mask-image:radial-gradient(ellipse_at_top_right,black_10%,transparent_65%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative pt-12 pb-16 md:pt-20 md:pb-24">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="order-2 lg:order-1 lg:col-span-7">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 font-mono text-[11px] leading-5 text-muted sm:text-xs"
        >
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-ok opacity-50 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2 rounded-full bg-ok"></span>
          </span>
          {t.status}
        </p>

        <h1 id="hero-title" class="mt-6 text-4xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl">
          {t.name}
        </h1>

        <p class="mt-5 text-lg font-medium tracking-tight sm:text-xl">{t.role}</p>
        <p class="mt-1.5 font-mono text-[13px] leading-6 text-muted">{t.degree}</p>

        <p class="mt-6 max-w-2xl text-base leading-7 text-pretty text-muted sm:text-lg sm:leading-8">{t.lead}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="#projects"
            class="group inline-flex h-11 items-center gap-2 rounded-lg bg-fg px-5 text-sm font-medium text-bg transition-opacity hover:opacity-90"
          >
            {t.ctaProjects}
            <Icon name="arrow-right" class="transition-transform duration-200 group-hover:translate-x-0.5" />
          </a>
          {
            CV_ENABLED && (
              <a
                href={t.cvHref}
                download={t.cvFile}
                class="group inline-flex h-11 items-center gap-2 rounded-lg border border-line-strong bg-surface px-5 text-sm font-medium transition-colors hover:border-fg"
              >
                <Icon name="download" class="transition-transform duration-200 group-hover:translate-y-0.5" />
                {t.ctaCv}
              </a>
            )
          }
          <div class="flex items-center gap-1">
            <a
              href={PROFILE.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 items-center gap-2 rounded-lg px-3 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-fg"
            >
              <Icon name="github" size={18} />
              GitHub
            </a>
            <a
              href={PROFILE.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-11 items-center gap-2 rounded-lg px-3 text-sm font-medium text-muted transition-colors hover:bg-surface-2 hover:text-fg"
            >
              <Icon name="linkedin" size={18} />
              LinkedIn
            </a>
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2 lg:col-span-5">
        <figure class="relative w-full max-w-[11rem] sm:mx-auto sm:max-w-xs lg:ml-auto lg:max-w-sm">
          <div class="overflow-hidden rounded-2xl border border-line bg-surface-2 shadow-[0_1px_2px_rgb(0_0_0/0.04),0_12px_32px_-12px_rgb(0_0_0/0.18)]">
            <Picture
              src={portrait}
              alt={t.photoAlt}
              formats={['avif', 'webp']}
              widths={[320, 480, 640, 800]}
              sizes="(min-width: 1024px) 384px, (min-width: 640px) 320px, 272px"
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/5] w-full object-cover object-top"
            />
          </div>
          <figcaption class="mt-3 flex items-center justify-between font-mono text-[11px] text-subtle">
            <span class="inline-flex items-center gap-1.5"><Icon name="map-pin" size={12} /> Dresden, DE</span>
            <span>TU Dresden · UANL</span>
          </figcaption>
        </figure>
      </div>
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-12">
      <div class="rounded-xl border border-line bg-surface lg:col-span-7">
        <div class="flex items-center justify-between border-b border-line px-5 py-3">
          <h2 class="eyebrow">{t.availabilityTitle}</h2>
          <span class="font-mono text-[11px] text-subtle" aria-hidden="true">2027-03 → 2027-08</span>
        </div>
        <dl class="divide-y divide-line">
          {
            t.availability.map((row) => (
              <div class="grid gap-1 px-5 py-3 sm:grid-cols-[7rem_1fr] sm:gap-4">
                <dt class="font-mono text-xs leading-6 text-subtle">{row.label}</dt>
                <dd class="text-sm leading-6">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line lg:col-span-5">
        {
          t.facts.map((f) => (
            <li class="flex flex-col justify-between gap-3 bg-surface p-5">
              <span class="text-2xl font-semibold tracking-tight sm:text-3xl">{f.value}</span>
              <span class="text-xs leading-5 text-muted">{f.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
