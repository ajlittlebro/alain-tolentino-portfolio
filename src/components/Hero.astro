---
import { Picture } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import Icon from './Icon.astro';
import CopyEmail from './CopyEmail.astro';
import { getDict, PROFILE, CV, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = getDict(lang);
const t = d.hero;
const btnSecondary =
  'group inline-flex h-11 items-center gap-2 rounded-lg border border-strong bg-surface px-4 text-sm font-medium text-ink transition-colors duration-200 hover:border-brand';
---

<section class="relative overflow-hidden border-b border-hairline" aria-labelledby="hero-title">
  <div class="blueprint pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="container-page relative grid gap-12 pt-12 pb-16 md:pt-16 lg:grid-cols-12 lg:gap-10 lg:pt-20 lg:pb-24">
    <!-- Identity & value proposition (7 cols) -->
    <div class="lg:col-span-7">
      <p class="eyebrow flex items-start gap-2 text-ink-2">
        <Icon name="map-pin" size={13} class="mt-px shrink-0 text-workbench-ink" />
        <span>{t.eyebrow}</span>
      </p>
      <h1 id="hero-title" class="display-xl mt-6 text-balance text-brand">{t.name}</h1>
      <p class="mt-6 max-w-2xl text-base text-pretty text-ink-2 sm:text-lg sm:leading-8">{t.lead}</p>

      <a
        href={`#${d.sections.projects}`}
        class="group mt-9 inline-flex h-12 items-center gap-2 rounded-lg bg-brand px-6 text-[15px] font-semibold text-on-brand transition-opacity duration-200 hover:opacity-90"
      >
        {t.ctaProjects}
        <Icon name="arrow-right" class="transition-transform duration-200 group-hover:translate-x-0.5" />
      </a>

      <div class="mt-3 flex flex-wrap gap-3">
        <a href={CV.de.href} download={CV.de.file} hreflang="de" class={btnSecondary}>
          <Icon name="download" class="transition-transform duration-200 group-hover:translate-y-0.5" />
          {t.cvDe}
        </a>
        <a href={CV.en.href} download={CV.en.file} hreflang="en" class={btnSecondary}>
          <Icon name="download" class="transition-transform duration-200 group-hover:translate-y-0.5" />
          {t.cvEn}
        </a>
        <CopyEmail lang={lang} />
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-[13px]">
        <a href={PROFILE.github} target="_blank" rel="noopener noreferrer" class="group inline-flex min-h-11 items-center gap-2 text-ink-2 hover:text-ink">
          <Icon name="github" size={17} />
          <span class="link-underline">GitHub {PROFILE.githubHandle}</span>
          <Icon name="arrow-up-right" size={13} class="text-ink-3" />
        </a>
        <a href={PROFILE.linkedin} target="_blank" rel="noopener noreferrer" class="group inline-flex min-h-11 items-center gap-2 text-ink-2 hover:text-ink">
          <Icon name="linkedin" size={17} />
          <span class="link-underline">LinkedIn</span>
          <Icon name="arrow-up-right" size={13} class="text-ink-3" />
        </a>
      </div>
    </div>

    <!-- Portrait dossier & telemetry (5 cols) -->
    <div class="grid gap-4 sm:grid-cols-[minmax(0,15rem)_1fr] lg:col-span-5 lg:grid-cols-1">
      <figure class="relative w-44 sm:w-full lg:mx-auto lg:max-w-[19rem]">
        <div class="relative border border-strong bg-surface p-2">
          <span class="absolute -top-1.5 -left-1.5 size-3 border-t-2 border-l-2 border-workbench" aria-hidden="true"></span>
          <span class="absolute -top-1.5 -right-1.5 size-3 border-t-2 border-r-2 border-workbench" aria-hidden="true"></span>
          <span class="absolute -bottom-1.5 -left-1.5 size-3 border-b-2 border-l-2 border-workbench" aria-hidden="true"></span>
          <span class="absolute -right-1.5 -bottom-1.5 size-3 border-r-2 border-b-2 border-workbench" aria-hidden="true"></span>
          <Picture
            src={portrait}
            alt={t.photoAlt}
            formats={['avif', 'webp']}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 304px, (min-width: 640px) 240px, 176px"
            width={640}
            height={819}
            loading="eager"
            fetchpriority="high"
            class="aspect-[4/5] h-auto w-full bg-subtle object-cover object-top"
          />
        </div>
        <figcaption class="mt-2.5 flex justify-between font-mono text-[10.5px] tracking-wide text-ink-3 uppercase">
          <span>{t.photoCaption}</span>
          <span class="hidden sm:inline">51.05° N · 13.74° E</span>
        </figcaption>
      </figure>

      <div class="lg:mx-auto lg:w-full lg:max-w-[19rem]">
        <p class="eyebrow mb-2">{t.telemetryTitle}</p>
        <ul class="grid gap-px overflow-hidden rounded-xl border border-hairline bg-hairline">
          {
            t.metrics.map((m, i) => (
              <li class="bg-surface px-4 py-3.5">
                <p class="flex items-baseline justify-between gap-3">
                  <span class="font-mono text-xl font-semibold tracking-tight text-brand">{m.value}</span>
                  <span class="font-mono text-[10px] text-ink-3">T-0{i + 1}</span>
                </p>
                <p class="mt-1 text-sm font-semibold text-ink">{m.label}</p>
                <p class="text-xs leading-5 text-ink-2">{m.sub}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
