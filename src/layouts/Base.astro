---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict, PROFILE, ROUTES, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, route, title, description, noindex = false } = Astro.props;
const t = getDict(lang);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(ROUTES[route][lang], site).href;
const alternateDe = new URL(ROUTES[route].de, site).href;
const alternateEn = new URL(ROUTES[route].en, site).href;

// Static 1200×630 social card (generated once, see README).
const ogImageUrl = new URL('/og-image.png', site).href;

// schema.org/Person – public profile data only (no address, phone or birth date).
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alain Josué Tolentino Ibarra',
  url: new URL(ROUTES.home[lang], site).href,
  image: ogImageUrl,
  email: `mailto:${PROFILE.email}`,
  jobTitle: 'Student – Software Technology Engineering (B.Sc.)',
  description: t.meta.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Dresden', addressCountry: 'DE' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Universidad Autónoma de Nuevo León (UANL)' },
    { '@type': 'CollegeOrUniversity', name: 'Technische Universität Dresden' },
  ],
  knowsLanguage: ['es', 'en', 'de'],
  knowsAbout: ['HTML5', 'CSS3', 'Tailwind CSS', 'JavaScript', 'React', 'Astro', 'Node.js', 'Express.js', 'REST APIs', 'MySQL', 'Firebase'],
  sameAs: [PROFILE.github, PROFILE.linkedin],
};
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Alain Josué Tolentino Ibarra" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={alternateDe} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateDe} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />

    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1120" media="(prefers-color-scheme: dark)" />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <!-- Apply theme before first paint to avoid a flash -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:text-primary-fg"
    >
      {t.nav.skip}
    </a>
    <Header lang={lang} route={route} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Enable colour transitions only after first paint.
      requestAnimationFrame(() => document.documentElement.classList.add('theme-ready'));

      // Reveal-on-scroll (respects reduced motion via CSS).
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
