---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getDict, ROUTES, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, route, title, description, noindex = false } = Astro.props;
const t = getDict(lang);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(ROUTES[route][lang], site).href;
const alternateDe = new URL(ROUTES[route].de, site).href;
const alternateEn = new URL(ROUTES[route].en, site).href;

const ogImage = await getImage({ src: portrait, width: 1200, height: 1200, fit: 'cover', position: 'top', format: 'jpg', quality: 80 });
const ogImageUrl = new URL(ogImage.src, site).href;
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content="Alain Josué Tolentino Ibarra" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={alternateDe} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateDe} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />

    <!-- Apply theme before first paint to avoid a flash -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-md focus:bg-fg focus:px-4 focus:py-2 focus:text-sm focus:text-bg"
    >
      {t.nav.skip}
    </a>
    <Header lang={lang} route={route} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Enable colour transitions only after first paint.
      requestAnimationFrame(() => document.documentElement.classList.add('theme-ready'));

      // Reveal-on-scroll (respects reduced motion via CSS).
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
